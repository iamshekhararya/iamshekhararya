package Covid Vaccination Booking ;
import java.util.Scanner;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int choice;

        do {
            System.out.println("=== Covid Vaccination Booking ===");
            System.out.println("1. Book Slot");
            System.out.println("2. Show All Bookings");
            System.out.println("3. Search By Slot");
            System.out.println("4. Exit");
            System.out.print("Choose: ");
            choice = sc.nextInt();

            switch (choice) {
                case 1: BookingOperations.bookingslot(sc); break;
                case 2: BookingOperations.showBookings(); break;
                case 3: BookingOperations.searchBySlot(sc); break;
                case 4: System.out.println("Stay Safe. Bye!"); break;
                default: System.out.println("Invalid input.\n");
            }
        } while (choice != 4);
    }
}
